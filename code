(async function downloadAllEOBs() {
  // Target by the unique data-testid attribute and aria-label prefix
  const buttons = Array.from(
    document.querySelectorAll('button[data-testid="claims.eobSummaryTable.table-download-button"]')
  ).filter(btn => btn.getAttribute('aria-label')?.startsWith('Download EOB'));

  console.log(`Found ${buttons.length} EOB download button(s). Starting downloads...`);

  const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  for (let i = 0; i < buttons.length; i++) {
    const btn = buttons[i];
    const claimLabel = btn.getAttribute('aria-label') || `Button #${i + 1}`;

    // Scroll into view to trigger lazy-rendering/event handlers if necessary
    btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
    btn.click();
    console.log(`[${i + 1}/${buttons.length}] Clicked: ${claimLabel}`);

    // If this was the last button, don't wait further
    if (i === buttons.length - 1) {
      console.log('All downloads triggered.');
      break;
    }

    // Every 20 downloads, pause for 10 seconds; otherwise, wait 2 seconds
    if ((i + 1) % 20 === 0) {
      console.log(`Processed ${i + 1} items. Pausing for 10 seconds to avoid rate limiting...`);
      await delay(10000);
    } else {
      await delay(2000);
    }
  }
})();
